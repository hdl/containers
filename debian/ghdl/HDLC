set -e

case "$REGISTRY" in
  *bullseye) HDLC_GNAT=9;  HDLC_LLVM=11; HDLC_BACKTRACE=libgcc-9-dev ;;
  *bookworm) HDLC_GNAT=12; HDLC_LLVM=14; HDLC_BACKTRACE=libgcc-12-dev ;;
  *trixie)   HDLC_GNAT=14; HDLC_LLVM=19; HDLC_BACKTRACE=libbacktrace-dev ;;
  *)         echo "ERROR: unsupported REGISTRY: $REGISTRY" >&2; exit 1 ;;
esac

makedepends=(
  "gnat-$HDLC_GNAT"
  zlib1g-dev
)

makedepends_llvm=(
  "$HDLC_BACKTRACE"
  "llvm-$HDLC_LLVM-dev"
)

depends=(
  "libgnat-$HDLC_GNAT"
)

depends_llvm=(
  gcc
  libc-dev
  "libllvm$HDLC_LLVM"
  zlib1g-dev
)

setup_gnatmake() {
  command -v gnatmake >/dev/null 2>&1 || ln -s "/usr/bin/gnatmake-${1}" /usr/bin/gnatmake
}

build() {
  git clone https://github.com/ghdl/ghdl.git /tmp/ghdl
  mkdir /tmp/ghdl/build
  cd /tmp/ghdl/build
  ../configure --default-pic "$@"
  make GNATMAKE="gnatmake -j$(nproc)"
  make DESTDIR=/opt/ghdl install
}

build_mcode() {
  setup_gnatmake "$HDLC_GNAT"
  build
}

build_llvm() {
  setup_gnatmake "$HDLC_GNAT"
  build \
    --with-llvm-config="llvm-config-$HDLC_LLVM" \
    --with-backtrace-lib=$(dpkg -L "$HDLC_BACKTRACE" | grep libbacktrace.a)
}
