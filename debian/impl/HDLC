set -e

case "$REGISTRY" in
  *bullseye) HDLC_LIBOMP=libomp5-11 ;;
  *bookworm) HDLC_LIBOMP=libomp5 ;;
  *)         echo "ERROR: unsupported REGISTRY: $REGISTRY" >&2; exit 1 ;;
esac

depends=(
  libboost-all-dev
  "$HDLC_LIBOMP"
  make
)
