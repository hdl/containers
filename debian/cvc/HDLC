set -e

case "$REGISTRY" in
  *bullseye) HDLC_OPENJDK=11 ; HDLC_CLANG=clang-13 ;;
  *bookworm) HDLC_OPENJDK=17 ;;
  *trixie)   HDLC_OPENJDK=21 ;;
  *)         echo "ERROR: unsupported REGISTRY: $REGISTRY" >&2; exit 1 ;;
esac

makedepends=(
  libfl-dev
  libgmp-dev
  flex
  m4
  "openjdk-${HDLC_OPENJDK}-jre-headless"
)

[ -n "${HDLC_CLANG:-}" ] && makedepends+=("$HDLC_CLANG")

build() {
  if [ -n "${HDLC_CLANG:-}" ]; then
    export CC="$HDLC_CLANG" CXX="${HDLC_CLANG/clang/clang++}"
  fi
  git clone https://github.com/cvc5/cvc5.git /tmp/cvc5
  cd /tmp/cvc5
  git tag -d latest
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g;s/^v//g' > /tmp/hdlc.cvc.version
  ./configure.sh --auto-download unrestricted
  cd build
  make -j$(nproc)
  make DESTDIR=/opt/cvc install
}
