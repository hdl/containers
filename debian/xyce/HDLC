set -e

case "$REGISTRY" in
  *bullseye) HDLC_FFTW=3 ;   HDLC_AMD=2 ; HDLC_SUITESSPCONFIG=5 ; HDLC_CMAKE=1 ;;
  *bookworm) HDLC_FFTW=bin ; HDLC_AMD=2 ; HDLC_SUITESSPCONFIG=5 ; HDLC_CMAKE=1 ;;
  *trixie)   HDLC_FFTW=bin ; HDLC_AMD=3 ; HDLC_SUITESSPCONFIG=7 ; HDLC_CMAKE=0 ;;
  *)  echo "ERROR: unsupported REGISTRY: $REGISTRY" >&2; exit 1 ;;
esac

makedepends=(
  bison
  ca-certificates
  curl
  cmake
  make
  gfortran
  libfl-dev
  libfftw3-dev
  libsuitesparse-dev
  libblas-dev
  liblapack-dev
)

depends=(
  ca-certificates
  "libamd$HDLC_AMD"
  libgfortran5
  "libfftw3-$HDLC_FFTW"
  libblas3
  liblapack3
  "libsuitesparseconfig$HDLC_SUITESSPCONFIG"
)

build_trilinos() {
  mkdir -p Trilinos/trilinos-source
  curl -fsSL https://github.com/trilinos/Trilinos/archive/trilinos-release-16-2-2.tar.gz |
    tar xz -C Trilinos/trilinos-source --strip-components=1

  cd Trilinos
  FLAGS="-O3 -fPIC"
  cmake \
    -G "Unix Makefiles" \
    -DCMAKE_CXX_FLAGS="$FLAGS" \
    -DCMAKE_C_FLAGS="$FLAGS" \
    -DCMAKE_Fortran_FLAGS="$FLAGS" \
    -DCMAKE_INSTALL_PREFIX="$XYCE_OUTDIR" \
    -DCMAKE_MAKE_PROGRAM="make" \
    -DBUILD_SHARED_LIBS=ON \
    -DTrilinos_ENABLE_EXPLICIT_INSTANTIATION=ON \
    -DTrilinos_ENABLE_NOX=ON \
      -DNOX_ENABLE_LOCA=ON \
    -DTrilinos_ENABLE_EpetraExt=ON \
      -DEpetraExt_BUILD_BTF=ON \
      -DEpetraExt_BUILD_EXPERIMENTAL=ON \
      -DEpetraExt_BUILD_GRAPH_REORDERINGS=ON \
    -DTrilinos_ENABLE_TrilinosCouplings=ON \
    -DTrilinos_ENABLE_Ifpack=ON \
    -DTrilinos_ENABLE_AztecOO=ON \
    -DTrilinos_ENABLE_Belos=ON \
    -DTrilinos_ENABLE_Teuchos=ON \
      -DTrilinos_ENABLE_COMPLEX_DOUBLE=ON \
    -DTrilinos_ENABLE_Amesos=ON \
      -DAmesos_ENABLE_KLU=ON \
    -DTrilinos_ENABLE_Amesos2=ON \
      -DAmesos2_ENABLE_KLU2=ON \
      -DAmesos2_ENABLE_Basker=ON \
    -DTrilinos_ENABLE_Sacado=ON \
    -DTrilinos_ENABLE_Stokhos=ON \
    -DTrilinos_ENABLE_Kokkos=ON \
    -DTrilinos_ENABLE_ALL_OPTIONAL_PACKAGES=OFF \
    -DTPL_ENABLE_AMD=ON \
    -DAMD_LIBRARY_DIRS="/usr/lib" \
    -DTPL_AMD_INCLUDE_DIRS="/usr/include/suitesparse" \
    -DTPL_ENABLE_BLAS=ON \
    -DTPL_ENABLE_LAPACK=ON \
    ./trilinos-source
  make DESTDIR=/tmp/xyce/ -j$(nproc) install
}

build_xyce() {
  mkdir -p Xyce
  curl -fsSL https://codeload.github.com/Xyce/Xyce/tar.gz/master |
    tar xz -C Xyce --strip-components=1

  cd Xyce
  mkdir xyce-build
  cd xyce-build
  cmake .. \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="$XYCE_OUTDIR" \
    -DCMAKE_PREFIX_PATH="/tmp/xyce${XYCE_OUTDIR}" \
    -DBUILD_SHARED_LIBS=ON
  make DESTDIR=/tmp/xyce/ -j$(nproc) install
}

build() {
  mkdir -p /tmp/build
  cd /tmp/build

  # Trilinos 16.2.2 requires CMake >= 3.23 and Xyce master requires >= 3.26;
  # trixie ships CMake >= 3.31, bullseye/bookworm ship 3.18/3.25
  if [ "$HDLC_CMAKE" = 1 ]; then
    mkdir -p /opt/cmake
    curl -fsSL https://github.com/Kitware/CMake/releases/download/v3.28.1/cmake-3.28.1-linux-x86_64.tar.gz |
      tar xz -C /opt/cmake --strip-components=1
    export PATH="/opt/cmake/bin:$PATH"
  fi

  build_trilinos
  build_xyce
}
