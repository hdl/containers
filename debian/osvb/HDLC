set -e

case "$REGISTRY" in
  *bullseye) HDLC_VUNIT="v4.7.0" ;;
  *bookworm|*trixie) HDLC_VUNIT="master" ;;
  *) echo "ERROR: unsupported REGISTRY: $REGISTRY" >&2; exit 1 ;;
esac

makedepends=(
  g++
  git
  python3-dev
)

build() {
  mkdir /tmp/osvb

  git clone --recurse-submodules https://github.com/cocotb/cocotb /tmp/cocotb
  case "$REGISTRY" in
    *bookworm|*trixie)
      grep -q 'license = "BSD-3-Clause"' /tmp/cocotb/pyproject.toml \
        && sed -i 's/license = "BSD-3-Clause"/license = {file = "LICENSE"}/' /tmp/cocotb/pyproject.toml \
        && sed -i '/license-files = \[/,/\]/d' /tmp/cocotb/pyproject.toml \
        || { echo 'cocotb pyproject.toml unexpectedly changed; license patch out of date' >&2; exit 1; }
      ;;
    *bullseye)
      ;;
    *)
      echo "ERROR: unsupported REGISTRY: $REGISTRY" >&2; exit 1
      ;;
  esac
  cd /tmp/cocotb && python3 setup.py bdist_wheel
  mv dist/*.whl /tmp/osvb/

  git clone -b "$HDLC_VUNIT" --recurse-submodules https://github.com/VUnit/vunit /tmp/vunit
  cd /tmp/vunit && python3 setup.py bdist_wheel
  mv dist/*.whl /tmp/osvb/

  git clone --recurse-submodules https://github.com/osvvm/OsvvmLibraries /tmp/osvb/osvvmlibs
}

depends=(
  libpython3-dev
)
