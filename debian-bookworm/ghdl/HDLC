set -e

makedepends=(
  gnat-12
  zlib1g-dev
)

makedepends_llvm=(
  llvm-14-dev
)

depends=(
  libgnat-12
)

depends_llvm=(
  gcc
  libc-dev
  libllvm14
  zlib1g-dev
)

setup_gnatmake() {
  command -v gnatmake >/dev/null 2>&1 || ln -s "/usr/bin/gnatmake-${1}" /usr/bin/gnatmake
}

build() {
  git clone https://github.com/ghdl/ghdl.git /tmp/ghdl
  mkdir /tmp/ghdl/build
  cd /tmp/ghdl/build
  ../configure --default-pic "$@"
  make GNATMAKE="gnatmake -j$(nproc)"
  make DESTDIR=/opt/ghdl install
}

build_mcode() {
  setup_gnatmake 12
  build
}

build_llvm() {
  setup_gnatmake 12
  build \
    --with-llvm-config=llvm-config-14 \
    --with-backtrace-lib=$(dpkg -L libgcc-12-dev | grep libbacktrace.a)
}
