set -e

makedepends=(
  gnat-9
  zlib1g-dev
)

makedepends_llvm=(
  llvm-11-dev
)

depends=(
  libgnat-9
)

depends_llvm=(
  gcc
  libc-dev
  libllvm11
  zlib1g-dev
)

setup_gnatmake() {
  command -v gnatmake >/dev/null 2>&1 || ln -s "/usr/bin/gnatmake-${1}" /usr/bin/gnatmake
}

build() {
  git clone https://github.com/ghdl/ghdl.git /tmp/ghdl
  mkdir /tmp/ghdl/build
  cd /tmp/ghdl/build
  ../configure --default-pic "$@"
  make GNATMAKE="gnatmake -j$(nproc)"
  make DESTDIR=/opt/ghdl install
}

build_mcode() {
  setup_gnatmake 9
  build
}

build_llvm() {
  setup_gnatmake 9
  build \
    --with-llvm-config=llvm-config-11 \
    --with-backtrace-lib=$(dpkg -L libgcc-9-dev | grep libbacktrace.a)
}
